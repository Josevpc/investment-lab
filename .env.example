# Back-end (variáveis lidas por backend/app/core/config.py)
# Caminho do banco. Padrão: data/investment.db na raiz do projeto.
# INVESTMENT_DATABASE_URL=sqlite:///C:/caminho/para/investment.db

# Origens permitidas no CORS, separadas por vírgula.
# INVESTMENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 0 desliga a migração automática (Alembic) ao subir a API.
# INVESTMENT_AUTO_MIGRATE=1

# 0 desliga a busca automática de CDI e Selic no Banco Central ao subir a API
# (útil sem internet). O botão "Atualizar agora" em Configurações continua disponível.
# INVESTMENT_BENCHMARKS_AUTO=1

# 1 liga o modo demonstração: popula um banco vazio com dados fictícios e mostra o selo na tela.
# Use com um INVESTMENT_DATABASE_URL separado (o demonstracao.bat já faz isso).
# INVESTMENT_DEMO=0

# Front-end (frontend/.env.local)
# URL base da API. Padrão: /api/v1, via proxy do Vite apontando para a API local.
# VITE_API_URL=http://127.0.0.1:8000/api/v1
# Destino do proxy de desenvolvimento.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Pasta com a tela compilada (npm run build) que a API serve em "/".
# Padrão: frontend/dist. Valor vazio desliga (útil com o Vite em desenvolvimento).
# INVESTMENT_STATIC_DIR=
